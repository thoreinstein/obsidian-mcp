{
  "name": "obsidian-mcp",
  "version": "0.1.0",
  "description": "Obsidian vault integration MCP server with local RAG capabilities",
  "main": "dist/index.js",
  "bin": {
    "obsidian-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --format=cjs --external:@lancedb/lancedb --external:onnxruntime-node --alias:sharp=./src/stubs/sharp.cjs --banner:js=\"var import_meta = { url: 'file://' + __filename };\" --define:import.meta=import_meta",
    "type-check": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thoreinstein/obsidian-mcp.git"
  },
  "homepage": "https://github.com/thoreinstein/obsidian-mcp#readme",
  "bugs": {
    "url": "https://github.com/thoreinstein/obsidian-mcp/issues"
  },
  "keywords": [
    "obsidian",
    "rag",
    "lancedb",
    "mcp",
    "model-context-protocol"
  ],
  "author": "thoreinstein",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@lancedb/lancedb": "^0.40.0",
    "onnxruntime-node": "1.30.0"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.0",
    "glob": "^13.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.3.2",
    "typescript": "^6.0.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@huggingface/transformers": "4.3.1"
  }
}
